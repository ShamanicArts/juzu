{
  "name": "juzu",
  "version": "0.1.0",
  "description": "High-performance Canvas visualization for Jujutsu VCS",
  "keywords": ["jujutsu", "jj", "vcs", "git", "visualization", "canvas"],
  "author": "",
  "license": "MIT",
  "bin": {
    "juzu": "./cli.ts"
  },
  "scripts": {
    "start": "bun run cli.ts",
    "dev": "bun run cli.ts --port=3000",
    "web": "bun run server.ts",
    "web:dev": "bun run server.ts",
    "tui": "bun run cli.ts --tui",
    "bench:tui": "bun run scripts/bench/tui-memory.ts",
    "bench:pid": "bun run scripts/bench/pid-memory.ts",
    "bench:trace": "bun run scripts/bench/analyze-mem-trace.ts",
    "bench:startup": "bun run scripts/bench/startup.ts",
    "bench:rust-tui": "python3 scripts/rust-port-tui-benchmark.py",
    "bench:compare": "bun run scripts/bench/compare.ts",
    "oracle:snapshot": "bun run scripts/rust-port-oracle.ts snapshot",
    "oracle:layout": "bun run scripts/rust-port-oracle.ts layout",
    "oracle:sidebar": "bun run scripts/rust-port-oracle.ts sidebar",
    "oracle:state": "bun run scripts/rust-port-oracle.ts state-after-keys",
    "parity:snapshot": "python3 scripts/rust-port-snapshot-parity.py",
    "parity:layout": "python3 scripts/rust-port-layout-parity.py",
    "parity:files": "python3 scripts/rust-port-files-parity.py",
    "parity:diff": "python3 scripts/rust-port-diff-parity.py",
    "review:diff-model": "python3 scripts/rust-port-diff-model-review.py",
    "review:diff-render": "python3 scripts/rust-port-diff-render-review.py",
    "parity:tui-modal": "python3 scripts/rust-port-tui-modal-parity.py",
    "config:export": "bun run scripts/export-config.ts",
    "themes:export": "bun run scripts/export-themes.ts",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "files": [
    "cli.ts",
    "server.ts",
    "src/",
    "themes/",
    "public/",
    "config.example.toml",
    "bun.d.ts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": ""
  },
  "dependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-typescript": "^7.26.0",
    "@opentui/core": "^0.1.77",
    "@opentui/solid": "^0.1.77",
    "babel-preset-solid": "^1.9.3",
    "clipboardy": "^5.2.1",
    "juzu": ".",
    "solid-js": "^1.9.11"
  }
}
